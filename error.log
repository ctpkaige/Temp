$ kubectl get deploy envoy-envoy-gateway-system-eg-gateway-b87277ac -n envoy-gateway-system -o yaml | grep -i -A 2 -B 2 "xds"
              grpc_services:
              - envoy_grpc:
                  cluster_name: xds_cluster
              set_node_on_first_message_only: true
            lds_config:
--
            - connect_timeout: 10s
              load_assignment:
                cluster_name: xds_cluster
                endpoints:
                - load_balancing_weight: 1
--
                        interval: 30s
                        timeout: 5s
              name: xds_cluster
              type: STRICT_DNS
              transport_socket:
--
                      tls_maximum_protocol_version: TLSv1_3
                    tls_certificate_sds_secret_configs:
                    - name: xds_certificate
                      sds_config:
                        path_config_source:
                          path: /sds/xds-certificate.json
                        resource_api_version: V3
                    validation_context_sds_secret_config:
                      name: xds_trusted_ca
                      sds_config:
                        path_config_source:
                          path: /sds/xds-trusted-ca.json
                        resource_api_version: V3
          overload_manager:
--
          defaultMode: 420
          items:
          - key: xds-trusted-ca.json
            path: xds-trusted-ca.json
          - key: xds-certificate.json
            path: xds-certificate.json
          name: envoy-envoy-gateway-system-eg-gateway-b87277ac
          optional: false

